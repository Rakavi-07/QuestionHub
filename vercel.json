$json = @'
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
'@

[System.IO.File]::WriteAllText(
    (Join-Path (Get-Location) "vercel.json"),
    $json,
    (New-Object System.Text.UTF8Encoding($false))
)